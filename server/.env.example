# Server Configuration
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/taskforge

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Email Service (Resend / SMTP)
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Razorpay Payment Gateway (Real Live UPI, Cards, Netbanking)
# Generate Live API Keys from: https://dashboard.razorpay.com/app/keys (Toggle to "Live Mode")
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_live_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_live_webhook_secret_here

# Cloudinary Image & Avatar Hosting (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
